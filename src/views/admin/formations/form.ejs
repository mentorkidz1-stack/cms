<%- include('../_header', { title }) %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">

<div class="admin-card">
	<form class="admin-form" action="<%= formation ? `/admin/formations/${formation.id}?_method=PUT` : '/admin/formations' %>" method="POST" enctype="multipart/form-data">
		<div class="field">
			<label for="title">Titre</label>
			<input type="text" id="title" name="title" required value="<%= formation ? formation.title : '' %>">
		</div>

		<div class="field">
			<label for="description">Description courte</label>
			<textarea id="description" name="description" rows="3" required><%= formation ? formation.description : '' %></textarea>
		</div>

		<div class="field">
			<label for="price">Prix (FCFA)</label>
			<input type="number" id="price" name="price" min="0" required value="<%= formation ? formation.price : '' %>">
		</div>

		<div class="field">
			<label>Programme de la formation</label>
			<div id="program-editor" class="quill-editor"><%- formation ? formation.program : '' %></div>
			<input type="hidden" name="program" id="program-input">
		</div>

		<div class="field">
			<label for="image">Image</label>
			<% if (formation && formation.imageUrl) { %>
				<img class="current-image" src="<%= formation.imageUrl %>" alt="">
			<% } %>
			<input type="file" id="image" name="image" accept="image/*">
			<p class="hint">JPG, PNG ou WEBP, 5 Mo max. Laissez vide pour conserver l'image actuelle.</p>
		</div>

		<div class="field checkbox-field">
			<input type="checkbox" id="published" name="published" <%= (!formation || formation.published) ? 'checked' : '' %>>
			<label for="published" style="margin-bottom: 0;">Publié (visible sur le site)</label>
		</div>

		<div class="d-flex gap-10px">
			<button type="submit" class="admin-btn"><%= formation ? 'Enregistrer' : 'Créer la formation' %></button>
			<a href="/admin/formations" class="admin-btn admin-btn--ghost">Annuler</a>
		</div>
	</form>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script>
	var programQuill = new Quill('#program-editor', { theme: 'snow' });
	var programForm = document.querySelector('.admin-form');
	var programInput = document.getElementById('program-input');
	programForm.addEventListener('submit', function () {
		programInput.value = programQuill.root.innerHTML;
	});
</script>

<%- include('../_footer') %>
