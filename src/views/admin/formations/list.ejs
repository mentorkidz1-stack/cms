<%- include('../_header', { title }) %>

<div class="admin-toolbar">
	<p class="hint mb-0"><%= formations.length %> formation(s)</p>
	<a href="/admin/formations/new" class="admin-btn"><i class="iconify" data-icon="mdi:plus"></i> Nouvelle formation</a>
</div>

<table class="admin-table">
	<thead>
		<tr>
			<th>Image</th>
			<th>Titre</th>
			<th>Prix</th>
			<th>Statut</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		<% if (formations.length === 0) { %>
			<tr><td colspan="5" class="hint">Aucune formation pour le moment.</td></tr>
		<% } %>
		<% formations.forEach(f => { %>
			<tr>
				<td><img class="thumb" src="<%= f.imageUrl || '/images/courses/courses-large-01.png' %>" alt=""></td>
				<td><%= f.title %></td>
				<td><%= f.price.toLocaleString('fr-FR') %> FCFA</td>
				<td><span class="<%= f.published ? 'badge-published' : 'badge-draft' %>"><%= f.published ? 'Publié' : 'Brouillon' %></span></td>
				<td>
					<div class="d-flex gap-10px">
						<a href="/formations/<%= f.slug %>" target="_blank" class="admin-btn admin-btn--ghost admin-btn--sm">Voir</a>
						<a href="/admin/formations/<%= f.id %>/edit" class="admin-btn admin-btn--ghost admin-btn--sm">Modifier</a>
						<form action="/admin/formations/<%= f.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Supprimer cette formation ?');">
							<button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">Supprimer</button>
						</form>
					</div>
				</td>
			</tr>
		<% }) %>
	</tbody>
</table>

<%- include('../_footer') %>
