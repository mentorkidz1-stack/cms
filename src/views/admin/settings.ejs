<%- include('./_header', { title }) %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">

<div class="admin-card" style="max-width: 720px;">
	<form class="admin-form" action="/admin/settings" method="POST" enctype="multipart/form-data">
		<input type="hidden" name="settingsFormSubmitted" value="1">
		<h3 class="mb-15px">Coordonnées</h3>

		<div class="field">
			<label for="siteName">Nom du site</label>
			<input type="text" id="siteName" name="siteName" required value="<%= settingsForm.siteName %>">
		</div>

		<div class="field">
			<label for="whatsappNumber">Numéro WhatsApp (format international, sans espaces)</label>
			<input type="text" id="whatsappNumber" name="whatsappNumber" placeholder="22990000000" value="<%= settingsForm.whatsappNumber %>">
			<p class="hint">Ce numéro reçoit les messages "S'inscrire" / "Payer maintenant" envoyés depuis le site.</p>
		</div>

		<div class="field">
			<label for="contactEmail">Email de contact</label>
			<input type="email" id="contactEmail" name="contactEmail" value="<%= settingsForm.contactEmail %>">
		</div>

		<hr class="my-25px">
		<h3 class="mb-15px">Menu de navigation</h3>
		<p class="hint mb-15px">Activez ou désactivez les rubriques affichées sur le site. Une rubrique désactivée disparaît du menu et sa page devient inaccessible.</p>

		<div class="menu-toggle-grid">
			<div class="field checkbox-field">
				<input type="checkbox" id="showFormations" name="showFormations" <%= settingsForm.showFormations ? 'checked' : '' %>>
				<label for="showFormations" style="margin-bottom: 0;"><%= settingsForm.formationsLabel %></label>
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="showServices" name="showServices" <%= settingsForm.showServices ? 'checked' : '' %>>
				<label for="showServices" style="margin-bottom: 0;"><%= settingsForm.servicesLabel %></label>
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="showGalerie" name="showGalerie" <%= settingsForm.showGalerie ? 'checked' : '' %>>
				<label for="showGalerie" style="margin-bottom: 0;">Galerie</label>
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="showBlog" name="showBlog" <%= settingsForm.showBlog ? 'checked' : '' %>>
				<label for="showBlog" style="margin-bottom: 0;"><%= settingsForm.blogLabel %></label>
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="showTemoignages" name="showTemoignages" <%= settingsForm.showTemoignages ? 'checked' : '' %>>
				<label for="showTemoignages" style="margin-bottom: 0;">Témoignages</label>
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="showEquipe" name="showEquipe" <%= settingsForm.showEquipe ? 'checked' : '' %>>
				<label for="showEquipe" style="margin-bottom: 0;"><%= settingsForm.equipeLabel %></label>
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="showAbout" name="showAbout" <%= settingsForm.showAbout ? 'checked' : '' %>>
				<label for="showAbout" style="margin-bottom: 0;">À propos</label>
			</div>
			<div class="field checkbox-field">
				<input type="checkbox" id="showPartenaires" name="showPartenaires" <%= settingsForm.showPartenaires ? 'checked' : '' %>>
				<label for="showPartenaires" style="margin-bottom: 0;">Bandeau Partenaires (accueil)</label>
			</div>
		</div>
		<p class="hint mb-0">Accueil et Contact sont toujours visibles.</p>

		<hr class="my-25px">
		<h3 class="mb-15px">Vocabulaire du site</h3>
		<p class="hint mb-15px">Ces mots s'appliquent partout automatiquement : menu, pied de page, page d'accueil, badges des fiches et messages WhatsApp. Par exemple, remplacez "Formations" par "Événements" si c'est plus adapté à votre activité.</p>

		<div class="field">
			<label for="formationsLabel">Formations — nom de la rubrique (pluriel)</label>
			<input type="text" id="formationsLabel" name="formationsLabel" required value="<%= settingsForm.formationsLabel %>">
		</div>
		<div class="field">
			<label for="formationsLabelSingular">Formations — nom au singulier</label>
			<input type="text" id="formationsLabelSingular" name="formationsLabelSingular" required value="<%= settingsForm.formationsLabelSingular %>">
		</div>

		<div class="field">
			<label for="servicesLabel">Services — nom de la rubrique (pluriel)</label>
			<input type="text" id="servicesLabel" name="servicesLabel" required value="<%= settingsForm.servicesLabel %>">
		</div>
		<div class="field">
			<label for="servicesLabelSingular">Services — nom au singulier</label>
			<input type="text" id="servicesLabelSingular" name="servicesLabelSingular" required value="<%= settingsForm.servicesLabelSingular %>">
		</div>

		<div class="field">
			<label for="blogLabel">Blog — nom de la rubrique</label>
			<input type="text" id="blogLabel" name="blogLabel" required value="<%= settingsForm.blogLabel %>">
		</div>

		<div class="field">
			<label for="equipeLabel">Équipe — nom de la rubrique</label>
			<input type="text" id="equipeLabel" name="equipeLabel" required value="<%= settingsForm.equipeLabel %>">
		</div>

		<hr class="my-25px">
		<h3 class="mb-15px">Apparence</h3>

		<div class="field">
			<label for="primaryColor">Couleur de marque</label>
			<div class="d-flex align-items-center gap-10px">
				<input type="color" id="primaryColor" name="primaryColor" value="<%= settingsForm.primaryColor %>" style="width: 60px; height: 40px; padding: 2px;">
				<span class="hint mb-0">Utilisée pour les boutons, liens et textes mis en avant sur tout le site.</span>
			</div>
		</div>

		<div class="field">
			<p class="hint mb-0">Le nom du signataire, sa signature et son cachet se gèrent désormais dans <a href="/admin/signataires">Signataires</a> — vous pouvez y enregistrer plusieurs personnes et choisir laquelle apparaît sur chaque reçu ou attestation généré.</p>
		</div>

		<hr class="my-25px">
		<h3 class="mb-15px">Identité visuelle — Logo</h3>
		<p class="hint mb-15px">Ce choix pilote l'affichage du logo dans l'en-tête et le pied de page du site (les reçus/attestations PDF utilisent toujours l'image si elle est renseignée, quel que soit ce réglage).</p>

		<div class="field">
			<div class="d-flex gap-20px">
				<label class="d-flex align-items-center gap-8px" style="font-weight: normal;">
					<input type="radio" name="logoType" value="text" id="logoTypeText" <%= settingsForm.logoType !== 'image' ? 'checked' : '' %> style="width: auto;">
					Logo texte
				</label>
				<label class="d-flex align-items-center gap-8px" style="font-weight: normal;">
					<input type="radio" name="logoType" value="image" id="logoTypeImage" <%= settingsForm.logoType === 'image' ? 'checked' : '' %> style="width: auto;">
					Logo image
				</label>
			</div>
		</div>

		<div id="logo-image-fields">
			<div class="field">
				<label for="logo">Fichier du logo</label>
				<% if (settingsForm.logoUrl) { %>
					<img class="current-image" style="object-fit: contain; background: #f5f7fb;" src="<%= settingsForm.logoUrl %>" alt="">
				<% } %>
				<input type="file" id="logo" name="logo" accept="image/*">
				<p class="hint">PNG, WEBP ou JPG avec fond transparent conseillé. S'affichera avec une hauteur maximale fixe, sans jamais être déformé.</p>
			</div>
		</div>

		<div id="logo-text-fields">
			<div class="field">
				<label for="logoHighlightWord">Mot à mettre en couleur (optionnel)</label>
				<input type="text" id="logoHighlightWord" name="logoHighlightWord" placeholder="Ex: Africa" value="<%= settingsForm.logoHighlightWord %>">
				<p class="hint">Doit correspondre à un mot présent dans le "Nom du site" ci-dessus (ex: "Africa" dans "CtechAfrica"). Laissez vide pour un logo entièrement uni.</p>
			</div>
			<div class="field">
				<label for="logoFontFamily">Typographie</label>
				<select id="logoFontFamily" name="logoFontFamily">
					<option value="sans" <%= settingsForm.logoFontFamily !== 'serif' ? 'selected' : '' %>>Moderne (sans-serif)</option>
					<option value="serif" <%= settingsForm.logoFontFamily === 'serif' ? 'selected' : '' %>>Élégante (serif)</option>
				</select>
			</div>
			<div class="field">
				<label for="logoFontSize">Taille du texte (pixels)</label>
				<input type="number" id="logoFontSize" name="logoFontSize" min="14" max="48" value="<%= settingsForm.logoFontSize %>">
			</div>
		</div>

		<div class="field">
			<label for="banner">Image de la bannière d'accueil</label>
			<% if (settingsForm.bannerImageUrl) { %>
				<img class="current-image" src="<%= settingsForm.bannerImageUrl %>" alt="">
			<% } %>
			<input type="file" id="banner" name="banner" accept="image/*">
			<p class="hint">JPG, PNG ou WEBP, 5 Mo max. Laissez vide pour conserver l'image actuelle.</p>
		</div>

		<hr class="my-25px">
		<h3 class="mb-15px">Page d'accueil</h3>

		<div class="field">
			<label for="heroTitle">Titre principal</label>
			<input type="text" id="heroTitle" name="heroTitle" required value="<%= settingsForm.heroTitle %>">
			<p class="hint">Entourez un passage de doubles accolades pour le mettre en couleur, ex : Vos données, votre code, votre {{avantage compétitif}}</p>
		</div>

		<div class="field">
			<label for="heroSubtitle">Sous-titre</label>
			<textarea id="heroSubtitle" name="heroSubtitle" rows="3" required><%= settingsForm.heroSubtitle %></textarea>
		</div>

		<hr class="my-25px">
		<h3 class="mb-15px">Page "À propos"</h3>

		<div class="field">
			<label>Contenu de la page</label>
			<div id="about-editor" class="quill-editor"><%- settingsForm.aboutContent %></div>
			<input type="hidden" name="aboutContent" id="about-input">
		</div>

		<hr class="my-25px">
		<h3 class="mb-15px">Sous-titres des pages</h3>
		<p class="hint mb-15px">Le grand titre de chaque page reprend automatiquement le nom de rubrique défini ci-dessus. Vous ne renseignez ici que la phrase d'introduction en dessous.</p>

		<div class="field">
			<label for="formationsSubheading">Page <%= settingsForm.formationsLabel %> — sous-titre</label>
			<textarea id="formationsSubheading" name="formationsSubheading" rows="2" required><%= settingsForm.formationsSubheading %></textarea>
		</div>

		<div class="field">
			<label for="servicesSubheading">Page <%= settingsForm.servicesLabel %> — sous-titre</label>
			<textarea id="servicesSubheading" name="servicesSubheading" rows="2" required><%= settingsForm.servicesSubheading %></textarea>
		</div>

		<div class="field">
			<label for="blogSubheading">Page <%= settingsForm.blogLabel %> — sous-titre</label>
			<textarea id="blogSubheading" name="blogSubheading" rows="2" required><%= settingsForm.blogSubheading %></textarea>
		</div>

		<div class="field">
			<label for="equipeSubheading">Page <%= settingsForm.equipeLabel %> — sous-titre</label>
			<textarea id="equipeSubheading" name="equipeSubheading" rows="2" required><%= settingsForm.equipeSubheading %></textarea>
		</div>

		<div class="field">
			<label for="contactHeading">Page Contact — titre</label>
			<input type="text" id="contactHeading" name="contactHeading" required value="<%= settingsForm.contactHeading %>">
		</div>
		<div class="field">
			<label for="contactSubheading">Page Contact — sous-titre</label>
			<textarea id="contactSubheading" name="contactSubheading" rows="2" required><%= settingsForm.contactSubheading %></textarea>
		</div>

		<hr class="my-25px">
		<h3 class="mb-15px" id="contact">Configuration du Contact</h3>
		<p class="hint mb-15px">Ces informations alimentent directement la page Contact publique (bouton WhatsApp, appel, adresse, carte, MoMo, badge de disponibilité).</p>

		<div class="field">
			<label for="defaultWhatsappMessage">Message WhatsApp pré-rempli</label>
			<textarea id="defaultWhatsappMessage" name="defaultWhatsappMessage" rows="2"><%= settingsForm.defaultWhatsappMessage %></textarea>
			<p class="hint">Pré-rempli quand un visiteur clique sur le bouton WhatsApp général de la page Contact (les fiches Formation/Service gardent leur propre message).</p>
		</div>

		<div class="field">
			<label for="phoneNumber">Numéro de téléphone (appel direct)</label>
			<input type="text" id="phoneNumber" name="phoneNumber" placeholder="+22990000000" value="<%= settingsForm.phoneNumber %>">
			<p class="hint">Affiche un bouton "Appeler" — peut être différent du numéro WhatsApp. Laissez vide pour le masquer.</p>
		</div>

		<div class="field checkbox-field">
			<input type="checkbox" id="showOnlineBadge" name="showOnlineBadge" <%= settingsForm.showOnlineBadge ? 'checked' : '' %>>
			<label for="showOnlineBadge" style="margin-bottom: 0;">Afficher le badge "🟢 En ligne – Réponse rapide"</label>
		</div>

		<div class="field">
			<label for="addressCity">Ville / quartier</label>
			<input type="text" id="addressCity" name="addressCity" placeholder="Ex: Cotonou, Cadjehoun" value="<%= settingsForm.addressCity %>">
		</div>

		<div class="field">
			<label for="addressLandmarks">Repères pour trouver le lieu</label>
			<textarea id="addressLandmarks" name="addressLandmarks" rows="2" placeholder="Ex: 2ème rue à droite après la pharmacie, immeuble bleu au 1er étage"><%= settingsForm.addressLandmarks %></textarea>
		</div>

		<div class="field">
			<label for="googleMapsUrl">Lien d'intégration Google Maps</label>
			<input type="text" id="googleMapsUrl" name="googleMapsUrl" placeholder="https://www.google.com/maps/embed?..." value="<%= settingsForm.googleMapsUrl %>">
			<p class="hint">Dans Google Maps : Partager → Intégrer une carte → copiez uniquement l'adresse (src="...") de la balise, pas tout le code.</p>
		</div>

		<div class="field">
			<label for="openingHours">Horaires d'ouverture</label>
			<input type="text" id="openingHours" name="openingHours" placeholder="Ex: Du Lundi au Samedi, de 08h à 18h" value="<%= settingsForm.openingHours %>">
		</div>

		<div class="field">
			<label for="momoDetails">Numéros Mobile Money</label>
			<input type="text" id="momoDetails" name="momoDetails" placeholder="Ex: MTN: 97XX XXXX / Moov: 95XX XXXX" value="<%= settingsForm.momoDetails %>">
		</div>

		<div class="field">
			<p class="hint mb-0">La Mini-FAQ affichée sur la page Contact se gère dans <a href="/admin/faq">FAQ</a>.</p>
		</div>

		<button type="submit" class="admin-btn">Enregistrer</button>
	</form>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script>
	var aboutQuill = new Quill('#about-editor', { theme: 'snow' });
	var settingsForm = document.querySelector('.admin-form');
	var aboutInput = document.getElementById('about-input');
	settingsForm.addEventListener('submit', function () {
		aboutInput.value = aboutQuill.root.innerHTML;
	});

	var logoImageFields = document.getElementById('logo-image-fields');
	var logoTextFields = document.getElementById('logo-text-fields');
	function toggleLogoFields() {
		var isImage = document.getElementById('logoTypeImage').checked;
		logoImageFields.style.display = isImage ? 'block' : 'none';
		logoTextFields.style.display = isImage ? 'none' : 'block';
	}
	document.getElementById('logoTypeText').addEventListener('change', toggleLogoFields);
	document.getElementById('logoTypeImage').addEventListener('change', toggleLogoFields);
	toggleLogoFields();
</script>

<%- include('./_footer') %>
