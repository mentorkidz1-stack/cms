<%- include('../_header', { title }) %>

<div class="admin-card">
	<form class="admin-form" action="<%= faq ? `/admin/faq/${faq.id}?_method=PUT` : '/admin/faq' %>" method="POST">
		<div class="field">
			<label for="question">Question</label>
			<input type="text" id="question" name="question" required value="<%= faq ? faq.question : '' %>">
		</div>

		<div class="field">
			<label for="answer">Réponse</label>
			<textarea id="answer" name="answer" rows="4" required><%= faq ? faq.answer : '' %></textarea>
		</div>

		<div class="field">
			<label for="order">Ordre d'affichage</label>
			<input type="number" id="order" name="order" value="<%= faq ? faq.order : 0 %>">
			<p class="hint">Les questions s'affichent de la plus petite à la plus grande valeur.</p>
		</div>

		<div class="field checkbox-field">
			<input type="checkbox" id="published" name="published" <%= (!faq || faq.published) ? 'checked' : '' %>>
			<label for="published" style="margin-bottom: 0;">Publié (visible sur le site)</label>
		</div>

		<div class="d-flex gap-10px">
			<button type="submit" class="admin-btn"><%= faq ? 'Enregistrer' : 'Ajouter la question' %></button>
			<a href="/admin/faq" class="admin-btn admin-btn--ghost">Annuler</a>
		</div>
	</form>
</div>

<%- include('../_footer') %>
