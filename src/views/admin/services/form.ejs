<%- include('../_header', { title }) %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">

<div class="admin-card">
	<form class="admin-form" action="<%= service ? `/admin/services/${service.id}?_method=PUT` : '/admin/services' %>" method="POST" enctype="multipart/form-data">
		<div class="field">
			<label for="title">Titre</label>
			<input type="text" id="title" name="title" required value="<%= service ? service.title : '' %>">
		</div>

		<div class="field">
			<label>Description</label>
			<div id="description-editor" class="quill-editor"><%- service ? service.description : '' %></div>
			<input type="hidden" name="description" id="description-input">
		</div>

		<div class="field">
			<label for="price">Prix (FCFA) — laissez vide pour "Sur devis"</label>
			<input type="number" id="price" name="price" min="0" value="<%= service && service.price ? service.price : '' %>">
		</div>

		<div class="field">
			<label for="image">Image</label>
			<% if (service && service.imageUrl) { %>
				<img class="current-image" src="<%= service.imageUrl %>" alt="">
			<% } %>
			<input type="file" id="image" name="image" accept="image/*">
			<p class="hint">JPG, PNG ou WEBP, 5 Mo max. Laissez vide pour conserver l'image actuelle.</p>
		</div>

		<div class="field checkbox-field">
			<input type="checkbox" id="published" name="published" <%= (!service || service.published) ? 'checked' : '' %>>
			<label for="published" style="margin-bottom: 0;">Publié (visible sur le site)</label>
		</div>

		<div class="d-flex gap-10px">
			<button type="submit" class="admin-btn"><%= service ? 'Enregistrer' : 'Créer le service' %></button>
			<a href="/admin/services" class="admin-btn admin-btn--ghost">Annuler</a>
		</div>
	</form>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script>
	var descQuill = new Quill('#description-editor', { theme: 'snow' });
	var descForm = document.querySelector('.admin-form');
	var descInput = document.getElementById('description-input');
	descForm.addEventListener('submit', function () {
		descInput.value = descQuill.root.innerHTML;
	});
</script>

<%- include('../_footer') %>
