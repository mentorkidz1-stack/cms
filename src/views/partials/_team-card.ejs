<article class="text-center border-radius-10px overflow-hidden mb-30px" style="border: 1px solid #eee;">
	<a href="/equipe/<%= member.slug %>">
		<img src="<%= member.photoUrl || '/images/avatar/user.png' %>" alt="<%= member.name %>" style="width: 100%; height: 260px; object-fit: cover;">
	</a>
	<div class="pt-20px pb-20px pe-15px ps-15px">
		<h4 class="fs-18 fw-semibold mb-5px">
			<a href="/equipe/<%= member.slug %>" class="transition-all"><%= member.name %></a>
		</h4>
		<p class="fs-14 mb-0" style="opacity: 0.7;"><%= member.role %></p>
	</div>
</article>
