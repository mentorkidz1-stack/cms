<div class="testimonial-card">
	<% if (testimonial.rating) { %>
		<div class="testimonial-card__rating">
			<% for (let i = 1; i <= 5; i++) { %>
				<i class="iconify fs-16" data-icon="<%= i <= testimonial.rating ? 'mdi:star' : 'mdi:star-outline' %>" style="color: #f2994a;"></i>
			<% } %>
		</div>
	<% } %>
	<p class="testimonial-card__quote fs-15">« <%= testimonial.quote %> »</p>

	<% if (testimonial.mediaType === 'audio' && testimonial.mediaUrl) { %>
		<div class="testimonial-card__media">
			<audio controls preload="none" src="<%= testimonial.mediaUrl %>" style="width: 100%;"></audio>
		</div>
	<% } else if (testimonial.mediaType === 'video' && testimonial.mediaUrl) { %>
		<% const embedUrl = youtubeEmbedUrl(testimonial.mediaUrl); %>
		<div class="testimonial-card__media">
			<% if (embedUrl) { %>
				<div class="testimonial-card__video-embed">
					<iframe src="<%= embedUrl %>" title="Témoignage vidéo" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
				</div>
			<% } else { %>
				<a href="<%= testimonial.mediaUrl %>" target="_blank" rel="noopener" class="fs-14 fw-semibold" style="color: var(--regal-blue);">
					<i class="iconify fs-16" data-icon="mdi:play-circle-outline"></i> Voir la vidéo
				</a>
			<% } %>
		</div>
	<% } %>

	<div class="testimonial-card__author">
		<img src="<%= testimonial.photoUrl || '/images/avatar/user.png' %>" alt="<%= testimonial.authorName %>">
		<div>
			<p class="fs-14 fw-semibold mb-0"><%= testimonial.authorName %></p>
			<% if (testimonial.authorRole) { %>
				<p class="fs-13 mb-0" style="opacity: 0.65;"><%= testimonial.authorRole %></p>
			<% } %>
		</div>
	</div>
</div>
