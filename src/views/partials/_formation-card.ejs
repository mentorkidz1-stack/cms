<article class="courses-layout-2__items">
	<div class="courses-layout-2__items__top position-relative">
		<figure>
			<a href="/formations/<%= formation.slug %>">
				<img src="<%= formation.imageUrl || '/images/courses/courses-large-01.png' %>" alt="<%= formation.title %>">
			</a>
			<figcaption class="courses-layout-2__items__cate text-capitalize">
				<span class="text-white"><%= settings.formationsLabelSingular %></span>
			</figcaption>
		</figure>
	</div>
	<div class="courses-layout-2__items__bottom pt-20px pb-20px pe-15px ps-15px">
		<h4 class="courses-layout-2__items__title fs-20 fw-semibold text-capitalize mb-12px">
			<a href="/formations/<%= formation.slug %>" class="transition-all line-clamp-2"><%= formation.title %></a>
		</h4>
		<p class="courses-layout-2__items__brief fs-14 line-clamp-2 mb-12px"><%= formation.description %></p>
		<div class="courses-layout-2__items__value d-flex align-items-center gap-10px mb-10px">
			<p class="courses-layout-2__items__price fs-18 fw-semibold mb-0"><%= formation.price.toLocaleString('fr-FR') %> FCFA</p>
		</div>
		<a href="/formations/<%= formation.slug %>" class="button button-type-01 fs-14 fw-semibold text-white text-capitalize transition-all d-flex align-items-center justify-content-center gap-5px">
			<span>En savoir plus</span>
		</a>
	</div>
</article>
