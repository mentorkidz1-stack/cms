<!DOCTYPE html>
<html class="no-js" lang="fr">

<head>
	<title><%= title %> | <%= settings.siteName %></title>
	<meta charset="UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="<%= settings.siteName %> — <%= settings.formationsLabel.toLowerCase() %>, <%= settings.servicesLabel.toLowerCase() %> et solutions en analyse de données, développement informatique et intelligence artificielle.">
	<link rel="shortcut icon" href="/images/favicon.png">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/assets/css/bootstrap.min.css">
	<link rel="stylesheet" href="/assets/css/swiper-bundle.min.css">
	<link rel="stylesheet" href="/assets/css/nouislider.min.css">
	<link rel="stylesheet" href="/assets/css/style.css?v=5.6">
	<link rel="stylesheet" href="/assets/css/demos/marketplace.css?v=5.6">
	<link rel="stylesheet" href="/assets/css/animate.css">
	<link rel="stylesheet" href="/assets/css/site.css">
	<style>
		:root { --regal-blue: <%= settings.primaryColor %>; }
	</style>
</head>

<body class="mkp-layout">

	<%
		const navItems = [
			{ href: '/', label: 'Accueil', show: true },
			{ href: '/formations', label: settings.formationsLabel, show: settings.showFormations },
			{ href: '/services', label: settings.servicesLabel, show: settings.showServices },
			{ href: '/galerie', label: 'Galerie', show: settings.showGalerie },
			{ href: '/blog', label: settings.blogLabel, show: settings.showBlog },
			{ href: '/temoignages', label: 'Témoignages', show: settings.showTemoignages },
			{ href: '/equipe', label: settings.equipeLabel, show: settings.showEquipe },
			{ href: '/about', label: 'À propos', show: settings.showAbout },
		].filter(item => item.show);
		const isActiveLink = (href) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
		const waLink = settings.whatsappNumber
			? `https://wa.me/${settings.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Bonjour ${settings.siteName}, j'aimerais avoir plus d'informations.`)}`
			: '/contact';
	%>
	<nav id="site-navbar" class="mkp-navbar navbar navbar-expand-lg pt-15px pb-15px">
		<div class="container ctech-nav-row">
			<div class="ctech-nav-row__logo">
				<%- include('./_logo', { variant: 'nav' }) %>
			</div>
			<div class="ctech-nav-row__links">
				<div class="bars-btn d-lg-none" role="button" aria-label="Ouvrir le menu">
					<span class="bars-btn__line"></span>
					<span class="bars-btn__line"></span>
					<span class="bars-btn__line"></span>
				</div>
				<div class="navbar-custom">
					<ul class="navbar-nav gap-10px">
						<li class="nav-item navbar-close d-lg-none">
							<i class="iconify fs-16" data-icon="teenyicons:left-outline"></i>
						</li>
						<% navItems.forEach(item => { %>
							<li class="nav-item">
								<a href="<%= item.href %>" class="nav-link-modern d-block pt-25px pb-25px pe-25px transition-all <%= isActiveLink(item.href) ? 'is-active' : '' %>"><%= item.label %></a>
							</li>
						<% }) %>
						<li class="nav-item d-lg-none mt-20px">
							<a href="<%= waLink %>" target="_blank" rel="noopener" class="nav-mobile-cta">
								<i class="iconify fs-20" data-icon="ic:baseline-whatsapp"></i>
								<span>Nous écrire sur WhatsApp</span>
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div class="ctech-nav-row__actions">
				<div class="navbar-act d-flex align-items-center justify-content-end">
					<a href="/contact" class="nav-cta">
						<span>Nous contacter</span>
					</a>
				</div>
			</div>
		</div>
	</nav>
